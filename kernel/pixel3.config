# Config fragment cho Pixel 3 XL (crosshatch), merge lên arm64 defconfig.
# Nguyên tắc: thứ cần cho lần boot đầu (lưu trữ, USB networking, hình ảnh) = built-in (y);
# phần còn lại = module (m).
CONFIG_LOCALVERSION="-pixel3"
# CONFIG_LOCALVERSION_AUTO is not set
# Tiết kiệm dung lượng/thời gian build
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_BTF is not set
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y

# --- Nền tảng SDM845 (bắt buộc built-in để UFS/USB/hiển thị lên được) ---
CONFIG_ARCH_QCOM=y
CONFIG_PINCTRL_SDM845=y
CONFIG_SDM_GCC_845=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SDM845=y
CONFIG_QCOM_PDC=y
CONFIG_ARM_SMMU=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_GENI_SE=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_QCOM_GPI_DMA=y

# --- UFS ---
# PHY_QCOM_QMP là menuconfig cha: phải =y thì các PHY con mới được =y
CONFIG_PHY_QCOM_QMP=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_EXT4_FS=y

# --- USB peripheral + gadget configfs (NCM để SSH, ACM làm serial dự phòng) ---
CONFIG_USB_SUPPORT=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_PHY_QCOM_QUSB2=y
# QMP COMBO (PHY USB3 của cổng USB-C) phụ thuộc TYPEC||TYPEC=n; defconfig để TYPEC=m -> kéo COMBO xuống m
CONFIG_TYPEC=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_CONFIGFS_FS=y

# --- Hình ảnh lần đầu: simple-framebuffer qua simpledrm + fbcon ---
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
# CONFIG_FB_SIMPLE is not set

# --- Hiển thị thật + GPU (module) ---
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_PANEL_SAMSUNG_S6E3HA8=m
CONFIG_DRM_PANEL_LG_SW43408=m
CONFIG_SDM_DISPCC_845=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# --- Remoteproc / QMI / Wi-Fi / BT / modem (module) ---
CONFIG_REMOTEPROC=y
CONFIG_QCOM_Q6V5_MSS=m
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_SYSMON=m
CONFIG_RPMSG_QCOM_GLINK_SMEM=m
CONFIG_QCOM_RMTFS_MEM=m
CONFIG_QCOM_PD_MAPPER=m
CONFIG_QRTR=m
CONFIG_QRTR_SMD=m
CONFIG_QRTR_TUN=m
CONFIG_QCOM_IPA=m
CONFIG_ATH10K=m
CONFIG_ATH10K_SNOC=m
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_SERIAL_DEV_BUS=y
CONFIG_BT_HCIUART_SERDEV=y
# bool, phụ thuộc BT_HCIUART (m)
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=m
CONFIG_SDM_VIDEOCC_845=m
CONFIG_VIDEO_QCOM_VENUS=m
CONFIG_UIO=m

# --- Pin / sạc ---
CONFIG_CHARGER_QCOM_SMB2=m
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_KEYBOARD_GPIO=y

# --- systemd ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CGROUPS=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y

# --- Docker (kiểm tra thêm bằng check-config.sh sau khi build) ---
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_CPUSETS=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_OVERLAY_FS=m
CONFIG_VETH=m
CONFIG_BRIDGE=m
CONFIG_BRIDGE_NETFILTER=m
CONFIG_VXLAN=m
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_COMPAT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_CT=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_IPVS=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_MARK=m
# Bảng iptables legacy (IP_NF_FILTER/NAT...) cần NETFILTER_XTABLES_LEGACY; Docker trên noble
# dùng iptables-nft qua NFT_COMPAT nên không bật legacy.
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP_VS=m
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y
CONFIG_SECCOMP_FILTER=y

# --- Bổ sung sau smoke test #1 (2026-11-13) ---
# Driver built-in chờ supplier là module -> hết deferred_probe_timeout (10s) thì bỏ cuộc:
#   arm-smmu 5040000.iommu (GPU SMMU) error -110 do gpucc=m; qcom-cpufreq-hw thiếu icc paths do OSM L3=m
CONFIG_SDM_GPUCC_845=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_QCOM_LLCC=y
# reboot-mode (pm8998 pon: mode-bootloader=2, mode-recovery=1) để `reboot bootloader` từ Linux
CONFIG_POWER_RESET_QCOM_PON=y
# Panel AMOLED cần nguồn bias LAB/IBB (vddpos/vddneg); refgen cho DSI PHY (smoke test #2: DSI chờ labibb/ibb)
CONFIG_REGULATOR_QCOM_LABIBB=m
CONFIG_REGULATOR_QCOM_REFGEN=m

# --- Docker, bổ sung sau Pha 4 (check-config.sh + lỗi "Extension DNAT revision 0 not supported") ---
# Docker dùng extension xtables (DNAT/MASQUERADE...) kể cả qua iptables-nft; kernel 7.x đặt bảng legacy sau XTABLES_LEGACY
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_RAW=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP_NF_TARGET_REDIRECT=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_IP6_NF_RAW=m
CONFIG_IP6_NF_NAT=m
CONFIG_IP6_NF_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_TARGET_REDIRECT=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NF_CONNTRACK_FTP=m
CONFIG_NF_CONNTRACK_TFTP=m
CONFIG_NF_NAT_FTP=m
CONFIG_NF_NAT_TFTP=m
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_NET_CLS_CGROUP=m
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=m
CONFIG_XFRM_USER=m
CONFIG_INET_ESP=m
CONFIG_DUMMY=m

# --- Snap (Pha 5): snapd mount squashfs nén XZ ("cannot mount squashfs image") + AppArmor cho confinement ---
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_LSM="landlock,lockdown,yama,integrity,apparmor"

# --- Sạc (Pha 5): qcom-smbx-charger deferred "Couldn't get usbin_v IIO channel" -> cần RRADC của PMI8998 ---
CONFIG_QCOM_SPMI_RRADC=m

# --- Cảm ứng (Pha 5): Pixel 3 XL dùng Samsung S6SY761 (dtbo gốc: sec,sec_ts @0x48) — KHÁC Pixel 3 (STM FTS5) ---
CONFIG_TOUCHSCREEN_S6SY761=m

# --- Pin (%): fuel gauge Maxim MAX1720x @ i2c12 0x36 (patch 0003) ---
CONFIG_BATTERY_MAX1720X=m
# --- Bật sẵn cho bước sau (chỉ nạp khi có node DT): ampli loa, camera trước ---
CONFIG_SND_SOC_CS35L36=m
CONFIG_VIDEO_IMX355=m

# --- Gỡ lỗi âm thanh (Pha 5): xem log q6asm/q6afe/q6adm qua /sys/kernel/debug/dynamic_debug ---
CONFIG_DYNAMIC_DEBUG=y
